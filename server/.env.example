# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the backend HTTP + WebSocket server listens on
PORT=4000

# Local Ollama server (default install listens here)
OLLAMA_URL=http://localhost:11434

# Any tool-calling capable model you've pulled, e.g:
#   ollama pull llama3.2:3b
# Note: device-control commands (open app/url, list devices, wake) use a
# regex fast-path in fallbackIntent.js and don't actually depend on this
# model's tool-calling reliability - the model is only hit for open-ended
# chat questions, which is why a small 3B model is fine here.
OLLAMA_MODEL=llama3.2:3b

# Shared secret - device agents (PC agent, phone bridge) must send this
# exact token when they connect, or they get rejected. Generate a random
# one, e.g. run: node -e "console.log(require('crypto').randomUUID())"
AGENT_TOKEN=replace-this-with-a-random-secret
